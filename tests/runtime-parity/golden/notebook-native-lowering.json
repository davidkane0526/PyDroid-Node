      "csvText": "a,b\n1,10\n3,30\n5,50\n7,70\n9,90\n11,110\n",
      "workflow": {
        "schemaVersion": 1,
        "name": "periodic group mean",
        "nodes": [
          {
            "id": "read",
            "position": {
              "x": 0,
              "y": 0
            },
            "data": {
              "label": "读取 CSV",
              "nodeType": "io.read_csv",
              "nodeVersion": 1,
              "parameters": {
                "separator": ",",
                "header": "infer"
              },
              "status": "idle"
            }
          },
          {
            "id": "mean",
            "position": {
              "x": 220,
              "y": 0
            },
            "data": {
              "label": "周期区间均值",
              "nodeType": "table.periodic_group_mean",
              "nodeVersion": 1,
              "parameters": {
                "groupSize": 3,
                "startRow": 2,
                "endRow": 3,
                "layout": "rows"
              },
              "status": "idle"
            }
          }
        ],
        "edges": [
          {
            "id": "e1",
            "source": "read",
            "target": "mean"
          }
        ]
      },
      "expected": {
        "status": "success",
        "executionOrder": [
          "read",
          "mean"
        ],
        "preview": {
          "columns": [
            "a",
            "b"
          ],
          "rows": [
            [
              4,
              40
            ],
            [
              10,
              100
            ]
          ],
          "totalRows": 2,
          "totalColumns": 2
        }
      }
    },
