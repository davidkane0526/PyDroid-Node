      "id": "plot_line",
      "description": "Line plot semantic parity",
      "csvText": "x,y\n0,1\n1,3\n2,2\n",
      "workflow": {
        "schemaVersion": 1,
        "name": "plot line",
        "nodes": [
          {
            "id": "read",
            "position": {
              "x": 0,
              "y": 0
            },
            "data": {
              "label": "读取",
              "nodeType": "io.read_csv",
              "nodeVersion": 1,
              "parameters": {
                "separator": ",",
                "header": "infer"
              },
              "status": "idle"
            }
          },
          {
            "id": "plot",
            "position": {
              "x": 200,
              "y": 0
            },
            "data": {
              "label": "折线",
              "nodeType": "plot.line",
              "nodeVersion": 1,
              "parameters": {
                "xColumn": "x",
                "yColumns": "y",
                "title": "Golden",
                "xLabel": "X",
                "yLabel": "Y",
                "legend": true,
                "grid": true,
                "logX": false,
                "logY": false,
                "scientificNotation": true,
                "lineStyle": "-",
                "marker": "o",
                "lineWidth": 1.5,
                "figureWidth": 8,
                "figureHeight": 4.5,
                "dpi": 120
              },
              "status": "idle"
            }
          }
        ],
        "edges": [
          {
            "id": "e1",
            "source": "read",
            "target": "plot"
          }
        ]
      },
      "expected": {
        "status": "success",
        "executionOrder": [
          "read",
          "plot"
        ],
        "plotNodes": [
          "plot"
        ]
      }
