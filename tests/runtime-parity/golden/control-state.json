    {
      "id": "print_scalar",
      "description": "Transparent print node keeps scalar output semantics",
      "csvText": "",
      "workflow": {
        "schemaVersion": 1,
        "name": "print",
        "nodes": [
          {
            "id": "range",
            "position": {
              "x": 0,
              "y": 0
            },
            "data": {
              "label": "Range",
              "nodeType": "logic.for_range",
              "nodeVersion": 1,
              "parameters": {
                "start": 0,
                "stop": 3,
                "step": 1
              },
              "status": "idle"
            }
          },
          {
            "id": "len",
            "position": {
              "x": 160,
              "y": 0
            },
            "data": {
              "label": "Len",
              "nodeType": "python.len",
              "nodeVersion": 1,
              "parameters": {},
              "status": "idle"
