    {
      "id": "scalar_len",
      "description": "Table input -> scalar len output",
      "csvText": "a,b\n1,2\n3,4\n5,6\n",
      "workflow": {
        "schemaVersion": 1,
        "name": "Parity len",
        "nodes": [
          {
            "id": "read",
            "position": {
              "x": 0,
              "y": 0
            },
            "data": {
              "label": "读取 CSV",
              "nodeType": "io.read_csv",
              "nodeVersion": 1,
              "parameters": {
                "separator": ",",
                "header": "infer"
              },
              "status": "idle"
            }
          },
          {
            "id": "len",
            "position": {
              "x": 200,
              "y": 0
            },
            "data": {
              "label": "长度",
              "nodeType": "python.len",
              "nodeVersion": 1,
              "parameters": {},
              "status": "idle"
            }
          }
        ],
        "edges": [
          {
            "id": "e1",
            "source": "read",
            "target": "len"
          }
        ]
      },
      "expected": {
        "status": "success",
        "executionOrder": [
          "read",
          "len"
        ],
        "valueResults": {
          "len": "3"
        }
      }
    },
