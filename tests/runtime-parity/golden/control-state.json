    {
      "id": "table_split_merge_rows",
      "description": "Split true/false branches then merge",
      "csvText": "x,y\n1,a\n2,b\n3,c\n4,d\n",
      "workflow": {
        "schemaVersion": 1,
        "name": "if merge",
        "nodes": [
          {
            "id": "read",
            "position": {
              "x": 0,
              "y": 0
            },
            "data": {
              "label": "读取",
              "nodeType": "io.read_csv",
              "nodeVersion": 1,
              "parameters": {
                "separator": ",",
                "header": "infer"
              },
              "status": "idle"
            }
          },
          {
            "id": "if",
            "position": {
              "x": 180,
              "y": 0
            },
            "data": {
              "label": "分支",
              "nodeType": "table.split_condition",
              "nodeVersion": 1,
              "parameters": {
                "condition": "x >= 3"
              },
              "status": "idle"
            }
          },
          {
            "id": "merge",
            "position": {
              "x": 360,
              "y": 0
            },
            "data": {
              "label": "合并",
              "nodeType": "table.merge_rows",
              "nodeVersion": 1,
              "parameters": {
                "ignoreIndex": true
              },
              "status": "idle"
            }
          }
        ],
        "edges": [
          {
            "id": "e1",
            "source": "read",
            "target": "if"
          },
          {
            "id": "e2",
            "source": "if",
            "target": "merge",
            "sourceHandle": "true",
            "targetHandle": "left"
          },
          {
            "id": "e3",
            "source": "if",
            "target": "merge",
            "sourceHandle": "false",
            "targetHandle": "right"
          }
        ]
      },
      "expected": {
        "status": "success",
        "executionOrder": [
          "read",
          "if",
          "merge"
        ],
        "preview": {
          "columns": [
            "x",
            "y"
          ],
          "rows": [
            [
              3,
              "c"
            ],
            [
              4,
              "d"
            ],
            [
              1,
              "a"
            ],
            [
              2,
              "b"
            ]
          ],
          "totalRows": 4,
          "totalColumns": 2
        }
      }
    },
