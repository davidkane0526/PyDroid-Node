              "y": 0
            },
            "data": {
              "label": "读取 CSV",
              "nodeType": "io.read_csv",
              "nodeVersion": 1,
              "parameters": {
                "separator": ",",
                "header": "infer"
              },
              "status": "idle"
            }
          },
          {
            "id": "records",
            "position": {
              "x": 200,
              "y": 0
            },
            "data": {
              "label": "记录列表",
              "nodeType": "convert.table_to_records",
              "nodeVersion": 1,
              "parameters": {},
              "status": "idle"
            }
          },
          {
            "id": "json",
            "position": {
              "x": 400,
              "y": 0
            },
            "data": {
              "label": "JSON",
              "nodeType": "convert.json_stringify",
              "nodeVersion": 1,
              "parameters": {
                "indent": 2
              },
              "status": "idle"
            }
          }
        ],
        "edges": [
          {
            "id": "e1",
            "source": "read",
            "target": "records"
          },
          {
            "id": "e2",
            "source": "records",
            "target": "json"
          }
        ]
      },
      "expected": {
        "status": "success",
        "executionOrder": [
          "read",
          "records",
          "json"
        ]
      }
    },
