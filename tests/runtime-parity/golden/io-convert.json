    {
      "id": "read_csv_batch",
      "description": "Batch CSV reader with source and filename metadata",
      "csvText": "",
      "inputFiles": [
        {
          "name": "sample_vg=-1v.csv",
          "text": "x,y\n1,10\n"
        },
        {
          "name": "sample_vg=2v.csv",
          "text": "x,y\n2,20\n"
        }
      ],
      "workflow": {
        "schemaVersion": 1,
        "name": "batch",
        "nodes": [
          {
            "id": "batch",
            "position": {
              "x": 0,
              "y": 0
            },
            "data": {
              "label": "批量读取",
              "nodeType": "io.read_csv_batch",
              "nodeVersion": 1,
              "parameters": {
                "separator": ",",
                "header": "infer",
                "skipRows": 0,
                "useColumns": "",
                "encoding": "utf-8",
                "sourceColumn": "source_file",
                "metadataColumn": "Vg_V",
                "filenamePattern": "vg\\s*=\\s*([-+]?\\d+(?:\\.\\d+)?)\\s*v",
                "onError": "error"
              },
              "status": "idle"
            }
          }
        ],
        "edges": []
      },
      "expected": {
        "status": "success",
        "executionOrder": [
          "batch"
        ]
      }
