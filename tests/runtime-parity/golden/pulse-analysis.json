    {
      "id": "ter_matrix_basic",
      "description": "TER matrix up/down sweep extraction",
      "csvText": "Vg_V,Vds_V,I_A\n0,-1,-0.001\n0,0,0.0001\n0,1,0.001\n0,0,0.0002\n0,-1,-0.0005\n",
      "workflow": {
        "schemaVersion": 1,
        "name": "TER",
        "nodes": [
          {
            "id": "read",
            "position": {
              "x": 0,
              "y": 0
            },
            "data": {
              "label": "读取",
              "nodeType": "io.read_csv",
              "nodeVersion": 1,
              "parameters": {
                "separator": ",",
                "header": "infer"
              },
              "status": "idle"
            }
          },
          {
            "id": "ter",
            "position": {
              "x": 220,
              "y": 0
            },
            "data": {
              "label": "TER",
              "nodeType": "analysis.ter_matrix",
              "nodeVersion": 1,
              "parameters": {
                "vgColumn": "Vg_V",
                "voltageColumn": "Vds_V",
                "currentColumn": "I_A",
                "sourceColumn": "",
                "vmin": -1,
                "vmax": 1,
                "vstep": 1,
                "tolerance": 0.1,
                "currentFloor": 1e-15,
                "mode": "high-low"
              },
              "status": "idle"
            }
          }
        ],
        "edges": [
          {
            "id": "e1",
            "source": "read",
            "target": "ter"
          }
        ]
      },
      "expected": {
        "status": "success",
        "executionOrder": [
          "read",
          "ter"
        ]
      }
    },
    {
      "id": "pulse_segment_basic",
      "description": "Segment measurement samples by generated waveform boundaries",
      "csvText": "time,current\n0.005,1\n0.015,2\n0.025,3\n0.035,4\n0.045,5\n",
      "workflow": {
        "schemaVersion": 1,
        "name": "segment",
        "nodes": [
          {
            "id": "measurement",
            "position": {
              "x": 0,
              "y": 0
            },
            "data": {
              "label": "测量",
              "nodeType": "io.read_csv",
              "nodeVersion": 1,
              "parameters": {
                "separator": ",",
                "header": "infer"
              },
              "status": "idle"
            }
          },
          {
            "id": "waveform",
            "position": {
              "x": 180,
              "y": 0
            },
            "data": {
              "label": "波形",
              "nodeType": "pulse.generate_waveform",
              "nodeVersion": 1,
              "parameters": {
                "voltageMax": 1,
                "voltageStep": 1,
                "readVoltage": 0.1,
                "pulseTime": 0.01,
                "readTime": 0.01,
                "timeShift": 0,
                "cycles": 0.25,
                "ratio": 1
              },
              "status": "idle"
            }
          },
          {
            "id": "segment",
            "position": {
              "x": 360,
              "y": 0
            },
            "data": {
              "label": "分段",
              "nodeType": "pulse.segment_measurement",
              "nodeVersion": 1,
              "parameters": {
                "measurementTimeColumn": "time",
                "currentColumn": "current",
                "waveformTimeColumn": "time_s",
                "waveformVoltageColumn": "voltage_V",
                "dropLeadingRows": 0,
                "dropTrailingRows": 0
              },
              "status": "idle"
            }
          }
        ],
        "edges": [
          {
            "id": "e1",
            "source": "measurement",
            "target": "segment",
            "sourceHandle": "output",
            "targetHandle": "measurement"
          },
          {
            "id": "e2",
            "source": "waveform",
            "target": "segment",
            "sourceHandle": "output",
            "targetHandle": "waveform"
          }
        ]
