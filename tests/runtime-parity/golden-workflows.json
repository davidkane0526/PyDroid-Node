{
  "schemaVersion": 1,
  "cases": [
    {
      "id": "csv_filter_head",
      "description": "CSV -> select columns -> range filter -> head",
      "csvText": "x,y,z\n-1,10,a\n0,20,b\n1,30,c\n2,40,d\n3,50,e\n",
      "workflow": {
        "schemaVersion": 1,
        "name": "Parity CSV filter",
        "nodes": [
          {"id":"read","position":{"x":0,"y":0},"data":{"label":"读取 CSV","nodeType":"io.read_csv","nodeVersion":1,"parameters":{"separator":",","header":"infer"},"status":"idle"}},
          {"id":"select","position":{"x":200,"y":0},"data":{"label":"选择列","nodeType":"table.select_columns","nodeVersion":1,"parameters":{"columns":"0,1"},"status":"idle"}},
          {"id":"filter","position":{"x":400,"y":0},"data":{"label":"范围筛选","nodeType":"table.filter_range","nodeVersion":1,"parameters":{"column":0,"min":"0","max":"2"},"status":"idle"}},
          {"id":"head","position":{"x":600,"y":0},"data":{"label":"前两行","nodeType":"pandas.head","nodeVersion":1,"parameters":{"n":2},"status":"idle"}}
        ],
        "edges": [
          {"id":"e1","source":"read","target":"select"},
          {"id":"e2","source":"select","target":"filter"},
          {"id":"e3","source":"filter","target":"head"}
        ]
      },
      "expected": {
        "status": "success",
        "executionOrder": ["read", "select", "filter", "head"],
        "preview": {"columns":["x","y"],"rows":[[0,20],[1,30]],"totalRows":2,"totalColumns":2},
        "nodePreviews": {
          "filter": {"columns":["x","y"],"rows":[[0,20],[1,30],[2,40]],"totalRows":3,"totalColumns":2}
        }
      }
    },
    {
      "id": "difference_fillna",
      "description": "Difference introduces null/NaN then fillna normalizes values",
      "csvText": "a,b\n1,10\n3,15\n6,25\n",
      "workflow": {
        "schemaVersion": 1,
        "name": "Parity difference",
        "nodes": [
          {"id":"read","position":{"x":0,"y":0},"data":{"label":"读取 CSV","nodeType":"io.read_csv","nodeVersion":1,"parameters":{"separator":",","header":"infer"},"status":"idle"}},
          {"id":"diff","position":{"x":200,"y":0},"data":{"label":"差分","nodeType":"table.difference","nodeVersion":1,"parameters":{"periods":1,"axis":0},"status":"idle"}},
          {"id":"fill","position":{"x":400,"y":0},"data":{"label":"填充空值","nodeType":"pandas.fillna","nodeVersion":1,"parameters":{"method":"value","value":"0"},"status":"idle"}}
        ],
        "edges": [
          {"id":"e1","source":"read","target":"diff"},
          {"id":"e2","source":"diff","target":"fill"}
        ]
      },
      "expected": {
        "status": "success",
        "executionOrder": ["read", "diff", "fill"],
        "preview": {"columns":["a","b"],"rows":[[0,0],[2,5],[3,10]],"totalRows":3,"totalColumns":2},
        "nodePreviews": {
          "diff": {"columns":["a","b"],"rows":[[null,null],[2,5],[3,10]],"totalRows":3,"totalColumns":2}
        }
      }
    },
    {
      "id": "scalar_len",
      "description": "Table input -> scalar len output",
      "csvText": "a,b\n1,2\n3,4\n5,6\n",
      "workflow": {
        "schemaVersion": 1,
        "name": "Parity len",
        "nodes": [
          {"id":"read","position":{"x":0,"y":0},"data":{"label":"读取 CSV","nodeType":"io.read_csv","nodeVersion":1,"parameters":{"separator":",","header":"infer"},"status":"idle"}},
          {"id":"len","position":{"x":200,"y":0},"data":{"label":"长度","nodeType":"python.len","nodeVersion":1,"parameters":{},"status":"idle"}}
        ],
        "edges": [{"id":"e1","source":"read","target":"len"}]
      },
      "expected": {
        "status": "success",
        "executionOrder": ["read", "len"],
        "valueResults": {"len":"3"}
      }
    },
    {
      "id": "invalid_column_error",
      "description": "Both engines must fail on the same node/type for invalid column selection",
      "csvText": "a,b\n1,2\n",
      "workflow": {
        "schemaVersion": 1,
        "name": "Parity error",
        "nodes": [
          {"id":"read","position":{"x":0,"y":0},"data":{"label":"读取 CSV","nodeType":"io.read_csv","nodeVersion":1,"parameters":{"separator":",","header":"infer"},"status":"idle"}},
          {"id":"select","position":{"x":200,"y":0},"data":{"label":"选择列","nodeType":"table.select_columns","nodeVersion":1,"parameters":{"columns":"99"},"status":"idle"}}
        ],
        "edges": [{"id":"e1","source":"read","target":"select"}]
      },
      "expected": {
        "status": "error",
        "nodeId": "select",
        "nodeType": "table.select_columns",
        "errorMessageIncludes": ["out of range"]
      }
    }
  ]
}
