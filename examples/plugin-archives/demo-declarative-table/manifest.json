{
  "schemaVersion": 1,
  "id": "demo.declarative-table",
  "name": "Declarative Table Demo",
  "version": "1.0.0",
  "description": "Declarative UI plus native Table output.",
  "nodes": [
    {
      "spec": {
        "nodeType": "demo.declarative_table",
        "label": "Declarative Table",
        "description": "Generate a native table with host-rendered grouped controls.",
        "tags": [
          "plugin",
          "ui",
          "table"
        ],
        "category": "自定义",
        "runtimeSupport": [
          "python",
          "javascript"
        ],
        "defaults": {
          "rows": 6,
          "scale": 2,
          "includeSquared": true
        },
        "parameters": [
          {
            "key": "rows",
            "label": "Rows",
            "kind": "number",
            "defaultValue": 6,
            "min": 1,
            "max": 100,
            "step": 1
          },
          {
            "key": "scale",
            "label": "Scale",
            "kind": "number",
            "defaultValue": 2,
            "step": 0.1
          },
          {
            "key": "includeSquared",
            "label": "Include squared",
            "kind": "boolean",
            "defaultValue": true
          }
        ],
        "inputPorts": [],
        "outputPorts": [
          {
            "id": "output",
            "label": "Table",
            "valueType": "table"
          }
        ],
        "ui": {
          "parameterGroups": [
            {
              "id": "data",
              "label": "Data",
              "parameters": [
                "rows",
                "scale"
              ],
              "description": "Generated table shape and value scale."
            },
            {
              "id": "columns",
              "label": "Columns",
              "parameters": [
                "includeSquared"
              ]
            }
          ],
          "status": [
            {
              "label": "Rows",
              "parameter": "rows"
            },
            {
              "label": "Scale",
              "parameter": "scale"
            },
            {
              "label": "Squared",
              "parameter": "includeSquared"
            }
          ],
          "help": {
            "title": "Plugin help",
            "resource": "resources/help.md"
          }
        }
      },
      "icon": "resources/icon.svg",
      "providers": {
        "javascript": {
          "file": "js/provider.js"
        },
        "python": {
          "file": "python/provider.py"
        }
      }
    }
  ],
  "resources": [
    "resources/help.md",
    "resources/icon.svg"
  ]
}
