  "description": "Declarative UI plus native Table output.",
  "nodes": [
    {
      "spec": {
        "nodeType": "demo.declarative_table",
        "label": "Declarative Table",
        "description": "Generate a native table with host-rendered grouped controls.",
        "tags": [
          "plugin",
          "ui",
          "table"
        ],
        "category": "自定义",
        "runtimeSupport": [
          "python",
          "javascript"
        ],
        "defaults": {
          "rows": 6,
          "scale": 2,
          "includeSquared": true
        },
        "parameters": [
          {
            "key": "rows",
            "label": "Rows",
            "kind": "number",
            "defaultValue": 6,
            "min": 1,
            "max": 100,
            "step": 1
          },
          {
            "key": "scale",
            "label": "Scale",
            "kind": "number",
            "defaultValue": 2,
            "step": 0.1
          },
          {
            "key": "includeSquared",
            "label": "Include squared",
            "kind": "boolean",
            "defaultValue": true
          }
        ],
        "inputPorts": [],
        "outputPorts": [
          {
            "id": "output",
            "label": "Table",
            "valueType": "table"
          }
        ],
        "ui": {
          "parameterGroups": [
            {
              "id": "data",
              "label": "Data",
              "parameters": [
                "rows",
                "scale"
              ],
              "description": "Generated table shape and value scale."
            },
            {
              "id": "columns",
              "label": "Columns",
              "parameters": [
                "includeSquared"
              ]
            }
          ],
          "status": [
            {
              "label": "Rows",
              "parameter": "rows"
            },
            {
              "label": "Scale",
              "parameter": "scale"
            },
            {
              "label": "Squared",
              "parameter": "includeSquared"
            }
          ],
          "help": {
            "title": "Plugin help",
            "resource": "resources/help.md"
          }
        }
      },
      "icon": "resources/icon.svg",
      "providers": {
        "javascript": {
          "source": "function execute(params, upstream, context, api) {\n  const rows = Math.max(1, Math.trunc(Number(params.rows ?? 6)));\n  const scale = Number(params.scale ?? 2);\n  const includeSquared = Boolean(params.includeSquared);\n  return api.Table.fromRecords(Array.from({ length: rows }, (_, index) => {\n    const value = index * scale;\n    return includeSquared ? { index, value, squared: value * value } : { index, value };\n  }));\n}\n"
        },
        "python": {
          "source": "def execute(params, upstream, context):\n    rows = max(1, int(params.get(\"rows\", 6)))\n    scale = float(params.get(\"scale\", 2))\n    include_squared = bool(params.get(\"includeSquared\", True))\n    values = [index * scale for index in range(rows)]\n    data = {\"index\": list(range(rows)), \"value\": values}\n    if include_squared:\n        data[\"squared\"] = [value * value for value in values]\n    return pd.DataFrame(data)\n"
        }
      }
    }
  ],
