{
  "schemaVersion": 1,
  "id": "demo.conditional-ui",
  "name": "Conditional UI Demo",
  "version": "1.0.0",
  "description": "Declarative visibility conditions and linked select options.",
  "nodes": [
    {
      "spec": {
        "nodeType": "demo.conditional_ui",
        "label": "Conditional UI",
        "description": "Host-rendered conditional parameter groups and linked enum options.",
        "tags": [
          "plugin",
          "ui",
          "conditional"
        ],
        "category": "自定义",
        "runtimeSupport": [
          "python",
          "javascript"
        ],
        "defaults": {
          "mode": "scale",
          "preset": "custom",
          "factor": 4,
          "offset": 2,
          "showHelp": true
        },
        "parameters": [
          {
            "key": "mode",
            "label": "Mode",
            "kind": "select",
            "defaultValue": "scale",
            "options": [
              {
                "label": "Scale",
                "value": "scale"
              },
              {
                "label": "Shift",
                "value": "shift"
              }
            ]
          },
          {
            "key": "preset",
            "label": "Preset",
            "kind": "select",
            "defaultValue": "custom",
            "options": [
              {
                "label": "Custom",
                "value": "custom"
              }
            ],
            "optionVariants": [
              {
                "when": {
                  "mode": "scale"
                },
                "options": [
                  {
                    "label": "Custom",
                    "value": "custom"
                  },
                  {
                    "label": "Double",
                    "value": "double"
                  },
                  {
                    "label": "Triple",
                    "value": "triple"
                  }
                ]
              },
              {
                "when": {
                  "mode": "shift"
                },
                "options": [
                  {
                    "label": "Custom",
                    "value": "custom"
                  },
                  {
                    "label": "Plus 1",
                    "value": "plus1"
                  },
                  {
                    "label": "Plus 5",
                    "value": "plus5"
                  }
                ]
              }
            ]
          },
          {
            "key": "factor",
            "label": "Factor",
            "kind": "number",
            "defaultValue": 4,
            "step": 0.1,
            "visibleWhen": {
              "mode": "scale"
            }
          },
          {
            "key": "offset",
            "label": "Offset",
            "kind": "number",
            "defaultValue": 2,
            "step": 0.1,
            "visibleWhen": {
              "mode": "shift"
            }
          },
          {
            "key": "showHelp",
            "label": "Show help",
            "kind": "boolean",
            "defaultValue": true
          }
        ],
        "inputPorts": [
          {
            "id": "input",
            "label": "Value",
            "valueType": "number",
            "required": true
          }
        ],
        "outputPorts": [
          {
            "id": "output",
            "label": "Result",
            "valueType": "number"
          }
        ],
        "ui": {
          "parameterGroups": [
            {
              "id": "operation",
              "label": "Operation",
              "parameters": [
                "mode",
                "preset"
              ]
            },
            {
              "id": "scale",
              "label": "Scale",
              "parameters": [
                "factor"
              ],
              "when": {
                "mode": "scale"
              }
            },
            {
              "id": "shift",
              "label": "Shift",
              "parameters": [
                "offset"
              ],
              "when": {
                "mode": "shift"
              }
            },
            {
              "id": "help",
              "label": "Help",
              "parameters": [
                "showHelp"
              ]
            }
          ],
          "status": [
            {
              "label": "Mode",
              "parameter": "mode"
            },
            {
              "label": "Factor",
              "parameter": "factor",
              "when": {
                "mode": "scale"
              }
            },
            {
              "label": "Offset",
              "parameter": "offset",
              "when": {
                "mode": "shift"
              }
            }
          ],
          "help": {
            "title": "Conditional UI",
            "resource": "resources/help.md",
            "when": {
              "showHelp": true
            }
          }
        }
      },
      "icon": "resources/icon.svg",
      "providers": {
        "javascript": {
          "source": "function execute(params, upstream) {\n  const value = Number(upstream ?? 0);\n  if (params.mode === \"shift\") {\n    const offset = params.preset === \"plus1\" ? 1 : params.preset === \"plus5\" ? 5 : Number(params.offset ?? 0);\n    return value + offset;\n  }\n  const factor = params.preset === \"double\" ? 2 : params.preset === \"triple\" ? 3 : Number(params.factor ?? 1);\n  return value * factor;\n}\n"
        },
        "python": {
          "source": "def execute(params, upstream, context):\n    value = float(upstream or 0)\n    if params.get(\"mode\") == \"shift\":\n        preset = params.get(\"preset\")\n        offset = 1 if preset == \"plus1\" else 5 if preset == \"plus5\" else float(params.get(\"offset\", 0))\n        return value + offset\n    preset = params.get(\"preset\")\n    factor = 2 if preset == \"double\" else 3 if preset == \"triple\" else float(params.get(\"factor\", 1))\n    return value * factor\n"
        }
      }
    }
  ],
