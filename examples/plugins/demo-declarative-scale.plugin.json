            {
              "label": "Factor",
              "parameter": "factor"
            },
            {
              "label": "Offset",
              "parameter": "offset"
            },
            {
              "label": "Enabled",
              "parameter": "enabled"
            }
          ],
          "help": {
            "title": "Declarative UI",
            "text": "Parameters, status and help are rendered by the PyDroid Node host.",
            "resource": "resources/help.md"
          }
        }
      },
      "icon": "resources/icon.svg",
      "providers": {
        "javascript": {
          "source": "function execute(params, upstream) {\n  if (!params.enabled) return Number(upstream ?? 0);\n  return Number(upstream ?? 0) * Number(params.factor ?? 1) + Number(params.offset ?? 0);\n}\n"
        },
        "python": {
          "source": "def execute(params, upstream, context):\n    value = float(upstream or 0)\n    if not params.get(\"enabled\", True):\n        return value\n    return value * float(params.get(\"factor\", 1)) + float(params.get(\"offset\", 0))\n"
        }
      }
    }
  ],
