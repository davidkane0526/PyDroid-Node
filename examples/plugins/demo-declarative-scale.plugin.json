        "defaults": {
          "factor": 3,
          "offset": 2,
          "enabled": true
        },
        "parameters": [
          {
            "key": "factor",
            "label": "Factor",
            "kind": "number",
            "defaultValue": 3,
            "step": 0.1
          },
          {
            "key": "offset",
            "label": "Offset",
            "kind": "number",
            "defaultValue": 2,
            "step": 0.1
