{
  "name": "pydroid-flow",
  "description": "Cross-platform visual data-processing workflow editor with Python and JavaScript runtimes",
  "author": "PyDroid Flow contributors",
  "private": true,
  "version": "1.4.21",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "main": "desktop/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "test:build-tools": "node scripts/build-tools-smoke.mjs",
    "test:version": "node scripts/check-version-sync.mjs",
    "check": "pnpm test:build-tools && pnpm test:version && pnpm test && pnpm test:python && pnpm build && pnpm desktop:build && pnpm test:desktop",
    "test": "vitest run",
    "test:python": "node scripts/python-run.mjs -m pytest -q",
    "test:desktop": "node scripts/python-run.mjs -m pytest -q python/tests/test_desktop_bridge.py",
    "audit:notebooks": "node scripts/python-run.mjs scripts/audit-notebooks.py",
    "version:bump": "node scripts/bump-version.mjs",
    "env:windows": "powershell -ExecutionPolicy Bypass -File scripts/setup-windows.ps1",
    "preview": "vite preview",
    "desktop": "pnpm desktop:quick",
    "desktop:quick": "pnpm desktop:build && electron desktop/main.cjs",
    "desktop:build": "tsc --noEmit -p desktop/tsconfig.json && vite build --config desktop/vite.config.ts",
    "desktop:dev": "node desktop/dev.cjs",
    "desktop:start": "pnpm desktop:build && electron desktop/main.cjs",
    "desktop:smoke": "pnpm desktop:build && node scripts/desktop-smoke.mjs",
    "desktop:package": "node scripts/desktop-package.mjs",
    "android:live": "powershell -ExecutionPolicy Bypass -File scripts/android-live.ps1",
    "android:live:lan": "powershell -ExecutionPolicy Bypass -File scripts/android-lan-live.ps1",
    "android:logs": "powershell -ExecutionPolicy Bypass -File scripts/android-logs.ps1",
    "android:sync": "pnpm build && cap sync android && powershell -ExecutionPolicy Bypass -File scripts/fix-capacitor-paths.ps1",
    "android:package": "powershell -ExecutionPolicy Bypass -File scripts/android-package.ps1",
    "android:emulator": "powershell -ExecutionPolicy Bypass -File scripts/android-emulator.ps1",
    "android:emulator:remove": "powershell -ExecutionPolicy Bypass -File scripts/android-emulator-remove.ps1",
    "android:open": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@xyflow/react": "^12.11.3",
    "echarts": "^6.1.0",
    "node-smb2": "^1.3.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "com.dk.pydroidflow.desktop",
    "productName": "PyDroid Flow",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/package-renderer/**/*",
      "desktop/main.cjs",
      "desktop/preload.cjs",
      "node_modules/node-smb2/**/*",
      "node_modules/des.js/**/*",
      "node_modules/inherits/**/*",
      "node_modules/js-md4/**/*",
      "node_modules/minimalistic-assert/**/*",
      "node_modules/moment/**/*",
      "node_modules/moment-timezone/**/*"
    ],
    "extraResources": [
      {
        "from": "python",
        "to": "python"
      },
      {
        "from": ".tools/python313-runtime",
        "to": "python-runtime"
      }
    ],
    "win": {
      "target": "dir",
      "icon": "desktop/icon.png",
      "signExecutable": false
    }
  }
}
